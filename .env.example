# Copy to .env and fill in the real values. Never commit this file.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production
PORT=3000
# The timezone the daily expiry reminder runs in.
TZ=Asia/Kuwait

# --- Persistence -----------------------------------------------------------
# The directory that is mounted from the host. It holds the SQLite database
# and the file bucket.
DATA_DIR=/data
UPLOADS_DIR=/data/uploads
# Optional: point the database somewhere else on the volume.
# DB_PATH=/data/romani.db

# --- Session ---------------------------------------------------------------
# Required in production. At least 32 characters, random.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=
JWT_TTL_SECONDS=43200

# --- SMTP (Gmail) ----------------------------------------------------------
# The password is a Google **app password**, not the account password.
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=samirfayez03@gmail.com
SMTP_PASS=
SMTP_FROM=ROMANI Flow <samirfayez03@gmail.com>

# --- Limits ----------------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_EMAIL_ATTACHMENT_MB=20
# ALLOWED_FILE_TYPES=application/pdf,image/png,image/jpeg

# --- Seeded administrators -------------------------------------------------
# Override only if the accounts should differ.
ADMIN_SEED_EMAILS=dr.vet.waleedtam@gmail.com,Room_samer20105@yahoo.com
ADMIN_SEED_PASSWORD=@Xx123456789xX@

# --- Scheduler -------------------------------------------------------------
CRON_ENABLED=true
CRON_SCHEDULE=0 8 * * *
