# Copy to .env and fill in the real values. Never commit this file.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production
PORT=3000
# The timezone the daily expiry reminder runs in.
TZ=Asia/Kuwait

# --- Persistence -----------------------------------------------------------
# The directory that is mounted from the host. It holds the SQLite database
# and the file bucket.
DATA_DIR=/data
UPLOADS_DIR=/data/uploads
# Optional: point the database somewhere else on the volume.
# DB_PATH=/data/romani.db

# --- Session ---------------------------------------------------------------
# Required in production. At least 32 characters, random.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=
JWT_TTL_SECONDS=43200

# --- SMTP (Gmail) ----------------------------------------------------------
# The password is a Google **app password**, not the account password.
# https://myaccount.google.com/apppasswords
# SMTP_USER, SMTP_PASS and SMTP_FROM are required and have no defaults.
# Fill in all three when enabling mail, including outside Compose.
# Direct Node startup only: to disable mail, leave SMTP_HOST, SMTP_USER,
# SMTP_PASS and SMTP_FROM empty. Compose always requires SMTP credentials.
# Also clear all supported host/user/password/from aliases (listed in README).
# SMTP_FROM example: ROMANI Flow <sender@example.com>
# Defaults to smtp.gmail.com once credentials are supplied.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Limits ----------------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_EMAIL_ATTACHMENT_MB=20
# ALLOWED_FILE_TYPES=application/pdf,image/png,image/jpeg

# --- First administrators --------------------------------------------------
# Needed on the first start of an empty database; accounts that already exist
# are never changed. There is no default password: choose one of at least 12
# characters and keep it only in the environment of the server.
ADMIN_SEED_EMAILS=
ADMIN_SEED_PASSWORD=

# --- Scheduler -------------------------------------------------------------
CRON_ENABLED=true
CRON_SCHEDULE=0 8 * * *

# --- Romani-only Evolution pairing (optional, backend only) -----------------
# Shared-service owner provisions a dedicated Romani instance and scoped key.
# Never reuse Curemed's instance/session or use a browser-supplied instance.
# Leave ALL four empty to disable pairing without affecting email.
# URL may include the operator-approved API prefix. No userinfo/query/fragment.
# Instance must be romani or romani-<suffix>; no instance is created by this app.
ROMANI_EVOLUTION_URL=
ROMANI_EVOLUTION_API_KEY=
ROMANI_EVOLUTION_INSTANCE=
# Independent random secret of at least 32 characters, not the API key.
# Dedicated instance webhook: /api/whatsapp/webhook, connection.update only,
# custom header x-romani-webhook-key. The service owner configures this securely.
ROMANI_EVOLUTION_WEBHOOK_SECRET=
